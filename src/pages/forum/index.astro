---
import '../../styles/forum.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/icons/Icon.astro';
import { forumCategories, forumPosts, getForumPostsEnriched } from '../../data/forum';
import { forumCategoryGuides } from '../../data/forumCategoryGuides';
import { forumCategoryBlurbs, forumGettingStarted } from '../../data/forumResources';

const enrichedPosts = getForumPostsEnriched();
import { resolvePageSeo } from '../../config/seo';
import { breadcrumbSchema, collectionPageSchema } from '../../utils/schema';
import { ROUTES } from '../../utils/path';

const seo = resolvePageSeo('/forum/');
const breadcrumbs = [{ name: 'Home', path: '/' }, { name: 'Forum', path: '/forum/' }];
const categoryKey = (name: string) => name.toLowerCase().replace(/[^a-z0-9]/g, '');
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  noindex={true}
  jsonLd={[
    collectionPageSchema({
      name: 'ROB RUN Forum – ESP, Radar & Utility Discussions',
      description: seo.description,
      url: '/forum/',
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <section class="forum-page py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
      <header class="forum-hero">
        <div>
          <p class="section-header__eyebrow">Community forum</p>
          <h1>ROB RUN Forum – ESP, Radar &amp; Utility Discussions</h1>
          <p class="forum-hero__copy">
            Ask quick questions, compare presets, and learn from other buyers—ESP overlays, radar range, Pro combat
            modules, HWID utilities, and post-patch loader fixes. Use support for private tickets; read the blog only for
            long-form guides.
          </p>
        </div>
        <a class="forum-create" href={ROUTES.support}>
          <Icon name="messageCircle" size={17} /> Start in support
        </a>
      </header>

      <div class="forum-layout">
        <main class="forum-main" aria-label="Community discussions">
          <div class="forum-toolbar">
            <span class="forum-online" aria-hidden="true">
              <i /> {forumPosts.length} active threads
            </span>
            <div class="forum-sort" role="group" aria-label="Discussion sorting">
              <button class="is-active" type="button" data-forum-sort="popular" aria-pressed="true">Popular</button>
              <button type="button" data-forum-sort="latest" aria-pressed="false">Latest</button>
              <button type="button" data-forum-sort="top" aria-pressed="false">Most discussed</button>
            </div>
            <span class="forum-preview-label" aria-hidden="true">Preview — sample buyer threads</span>
            <label class="forum-search">
              <Icon name="search" size={16} />
              <input
                type="search"
                placeholder="Search ESP, radar, loader…"
                aria-label="Search discussions"
                data-forum-search
              />
              <span class="sr-only" data-forum-count>{forumPosts.length} discussions</span>
            </label>
          </div>

          <div class="forum-category-filters" role="group" aria-label="Filter discussions by topic">
            <button type="button" class="is-active" data-forum-filter="all" aria-pressed="true">
              <Icon name="layers" size={14} /> All topics
            </button>
            {
              forumCategories.map((category) => (
                <button type="button" data-forum-filter={categoryKey(category.name)} aria-pressed="false">
                  <Icon name={category.icon} size={14} /> {category.name}
                </button>
              ))
            }
          </div>
          <p class="forum-results-count" data-forum-visible-count>{forumPosts.length} active discussions</p>
          <aside class="forum-static-note" aria-label="How to use this forum">
            <strong>New here?</strong>
            <ul>
              {forumGettingStarted.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
          </aside>

          <div class="forum-category-guides" data-forum-guides>
            {
              forumCategoryGuides.map((guide) => (
                <article
                  class="forum-category-guide"
                  data-forum-guide
                  data-guide-key={guide.filterKey}
                  hidden
                >
                  <h2>{guide.category}</h2>
                  <p class="forum-category-guide__intro">{guide.intro}</p>
                  {
                    guide.sections.map((section) => (
                      <div class="forum-detail-section">
                        <h3>{section.heading}</h3>
                        {section.paragraphs.map((p) => (
                          <p>{p}</p>
                        ))}
                      </div>
                    ))
                  }
                </article>
              ))
            }
          </div>

          <div class="forum-post-list" aria-live="polite">
            {
              enrichedPosts.map((post, index) => (
                <article
                  class="forum-post-card"
                  data-forum-card
                  data-post-slug={post.slug}
                  data-upvotes={post.upvotes}
                  data-category={categoryKey(post.category)}
                  data-comments={post.commentsCount}
                  data-published={post.publishedAt}
                  data-order={index}
                >
                  <div class="forum-vote" aria-label="Discussion voting">
                    <button class="forum-vote__up" type="button" data-vote-up aria-label="Upvote this discussion">
                      <Icon name="chevronDown" size={16} />
                    </button>
                    <strong data-vote-count>{post.upvotes}</strong>
                    <button type="button" disabled aria-label="Downvoting is unavailable">
                      <Icon name="chevronDown" size={16} />
                    </button>
                  </div>
                  <div class="forum-post-card__body">
                    <div class="forum-post-meta">
                      <span class={`forum-community-avatar tone-${post.categoryTone}`}>
                        <Icon name="users" size={15} />
                      </span>
                      <a href={`/forum/?category=${categoryKey(post.category)}`} class="forum-community-name">
                        d/{post.category.toLowerCase().replaceAll(/[^a-z0-9]/g, '')}
                      </a>
                      <span>·</span>
                      <span>
                        <Icon name="userRound" size={13} /> u/{post.author}
                      </span>
                      <span>{post.age}</span>
                    </div>
                    <a class="forum-post-title" href={`/forum/${post.slug}/`}>{post.title}</a>
                    <p class="forum-post-excerpt">{post.excerpt}</p>
                    {post.tldr && <p class="forum-post-tldr"><strong>TL;DR:</strong> {post.tldr}</p>}
                    <div class="forum-post-actions">
                      {post.flair && <span class={`forum-flair tone-${post.categoryTone}`}>{post.flair}</span>}
                      <a href={`/forum/${post.slug}/`}>
                        <Icon name="messageCircle" size={15} /> {post.commentsCount} community replies
                      </a>
                      <a href={`/forum/${post.slug}/`}>
                        <Icon name="arrowRight" size={15} /> Read discussion
                      </a>
                    </div>
                  </div>
                </article>
              ))
            }
          </div>
          <p class="forum-empty" data-forum-empty hidden>No discussions match. Try another search or topic.</p>
          <nav class="forum-pagination" aria-label="Discussion pages" data-forum-pagination hidden>
            <button type="button" data-page-previous aria-label="Previous page">Previous</button>
            <div class="forum-pagination__pages" data-page-buttons></div>
            <button type="button" data-page-next aria-label="Next page">Next</button>
            <span class="forum-pagination__status" data-page-status aria-live="polite"></span>
          </nav>
        </main>

        <aside class="forum-sidebar">
          <section class="forum-side-card forum-about" id="community-guidelines">
            <div class="forum-side-card__banner"></div>
            <div class="forum-about__content">
              <div class="forum-about__title">
                <span class="forum-community-avatar forum-community-avatar--brand">
                  <img src="/logo.png" alt="cheatsrobrun.org logo" width="34" height="34" />
                </span>
                <h2>Rob Run buyers</h2>
              </div>
              <p>
                Sample threads show how buyers talk about ESP, radar, and utilities. New here? Filter <strong>ESP &amp;
                Radar</strong> first, then open a thread with the most replies.
              </p>
              <div class="forum-stats">
                <span>
                  <b>{forumPosts.length}</b> discussions
                </span>
                <span>
                  <b>{forumCategories.length}</b> topics
                </span>
              </div>
              <a class="forum-join" href="/forum/">Open forum home</a>
            </div>
          </section>
          <section class="forum-side-card forum-rules">
            <h2 class="forum-side-heading">Quick tips</h2>
            <ol>
              <li>Sort by <strong>Latest</strong> after patches for loader threads.</li>
              <li>Use <strong>Most discussed</strong> to find proven ESP presets.</li>
              <li>Loader or HWID issues? Open <a href={ROUTES.support}>support</a> with a screenshot.</li>
            </ol>
          </section>
          <section class="forum-side-card" id="communities">
            <h2 class="forum-side-heading">Popular topics</h2>
            <ul class="forum-community-list">
              {
                forumCategories.map((category) => (
                  <li>
                    <a href={`/forum/?category=${categoryKey(category.name)}`}>
                      <span class={`forum-community-avatar tone-${category.tone}`} aria-hidden="true">
                        <Icon name={category.icon} size={15} />
                      </span>
                      <span>
                        <b>{category.name}</b>
                        <small>{forumCategoryBlurbs[category.name] ?? 'Buyer Q&amp;A'}</small>
                      </span>
                      <Icon name="chevronRight" size={15} />
                    </a>
                  </li>
                ))
              }
            </ul>
            <a class="forum-text-link" href="#communities">Browse all topics <Icon name="arrowRight" size={14} /></a>
          </section>
          <section class="forum-side-card forum-rules">
            <h2 class="forum-side-heading">Posting guidelines</h2>
            <ol>
              <li>No account credentials or order IDs in public threads</li>
              <li>Stay on ESP, radar, utilities, or loader topics</li>
              <li>Mark spoilers for unreleased patch leaks</li>
            </ol>
            <a href={ROUTES.support}>Need a private ticket? <Icon name="arrowRight" size={14} /></a>
          </section>
          <p class="forum-sidebar-foot">
            <a href="/blog/">Blog guides</a> · <a href={ROUTES.products}>Products</a> · <a href="/terms/">Terms</a>
            <br />© {new Date().getFullYear()} cheatsrobrun.org
          </p>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
