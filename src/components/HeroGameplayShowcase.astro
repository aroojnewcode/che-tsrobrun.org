---
import { ROB_RUN_HERO_SLIDES } from '../data/robRunMedia';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<figure class:list={['hero-showcase', className]} data-hero-showcase>
  <div class="hero-showcase__frame">
    {
      ROB_RUN_HERO_SLIDES.map((slide, index) => (
        <img
          src={slide.src}
          alt={slide.alt}
          width={1280}
          height={720}
          loading={index === 0 ? 'eager' : 'lazy'}
          decoding={index === 0 ? 'sync' : 'async'}
          fetchpriority={index === 0 ? 'high' : 'auto'}
          class:list={['hero-showcase__img', index !== 0 && 'is-hidden']}
          data-hero-slide
          data-index={index}
        />
      ))
    }
    {
      ROB_RUN_HERO_SLIDES.length > 1 && (
        <div class="hero-showcase__dots" role="tablist" aria-label="Hero gameplay screenshots">
          {ROB_RUN_HERO_SLIDES.map((slide, index) => (
            <button
              type="button"
              class:list={['hero-showcase__dot', index === 0 && 'is-active']}
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-label={slide.alt}
              data-hero-dot={index}
            />
          ))}
        </div>
      )
    }
  </div>
</figure>

<style>
  .hero-showcase {
    margin: 0;
    width: 100%;
  }

  .hero-showcase__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border-radius: 0.75rem;
    background: #0a0d10;
  }

  .hero-showcase__img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.35s ease;
  }

  .hero-showcase__img.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  .hero-showcase__dots {
    position: absolute;
    inset: auto 0.75rem 0.75rem;
    z-index: 2;
    display: flex;
    justify-content: center;
    gap: 0.4rem;
  }

  .hero-showcase__dot {
    width: 0.5rem;
    height: 0.5rem;
    border: 0;
    border-radius: 999px;
    background: color-mix(in oklch, white 35%, transparent);
    cursor: pointer;
    transition:
      transform 0.2s ease,
      background-color 0.2s ease;
  }

  .hero-showcase__dot.is-active {
    transform: scale(1.15);
    background: var(--primary);
  }

  .hero-showcase__dot:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }
</style>

<script>
  function initHeroShowcase(root: HTMLElement) {
    const slides = [...root.querySelectorAll<HTMLImageElement>('[data-hero-slide]')];
  const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-hero-dot]')];
    if (slides.length <= 1) return;

    let index = 0;
    let timer: ReturnType<typeof setInterval> | undefined;

    const show = (next: number) => {
      index = (next + slides.length) % slides.length;
      slides.forEach((el, i) => el.classList.toggle('is-hidden', i !== index));
      dots.forEach((el, i) => {
        el.classList.toggle('is-active', i === index);
        el.setAttribute('aria-selected', i === index ? 'true' : 'false');
      });
    };

    const restart = () => {
      if (timer) clearInterval(timer);
      timer = setInterval(() => show(index + 1), 6000);
    };

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const n = Number(dot.dataset.heroDot);
        if (!Number.isNaN(n)) {
          show(n);
          restart();
        }
      });
    });

    restart();
  }

  document.querySelectorAll<HTMLElement>('[data-hero-showcase]').forEach(initHeroShowcase);
</script>
